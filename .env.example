# =============================================================
# MetaMind AI — Master Environment Variables Template (.env.example)
# =============================================================

# -------------------------------------------------------------
# 1. Backend API Gateway (server/)
# -------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/metamind_ai?retryWrites=true&w=majority
JWT_SECRET=your_secure_jwt_secret_key_here
AI_SERVICE_URL=http://metamind-ai-service:8000
CLIENT_URL=https://metamind-client.onrender.com

# -------------------------------------------------------------
# 2. Frontend Client (client/)
# -------------------------------------------------------------
VITE_API_BASE_URL=https://metamind-server.onrender.com/api

# -------------------------------------------------------------
# 3. AI NLP Microservice (ai-service/)
# -------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
